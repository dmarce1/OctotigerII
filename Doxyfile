PROJECT_NAME           = OctotigerII
PROJECT_BRIEF          = "Typed CGS fields, independent mesh topology, and HPX execution"
OUTPUT_DIRECTORY       = $(OCTOTIGERII_DOC_OUTPUT)
INPUT                  = docs/conservation.md docs/amr.md docs/parallel-fmm.md docs/analytic-verification.md docs/index.md docs/numerics.md docs/documenting.md docs/groups.dox BIBLIOGRAPHY.md STORAGE.md VALIDATION.md BUILDING.md ROADMAP.md octotigerII src bin cmake/buildConfig.hpp.in
FILE_PATTERNS          = *.hpp *.cpp *.md *.dox *.in
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */types.def
USE_MDFILE_AS_MAINPAGE  = docs/index.md
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF       = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
HTML_DYNAMIC_MENUS     = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = $(OCTOTIGERII_DOC_OUTPUT)/warnings.log
WARN_AS_ERROR          = FAIL_ON_WARNINGS
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
EXTENSION_MAPPING       = in=C++
PREDEFINED             = OCTOTIGERII_WITH_HPX OCTOTIGERII_NDIM=3 OCTOTIGERII_GRAVITY=1 OCTOTIGERII_HYDRO=1 OCTOTIGERII_RADIATION=1 \
 "HPX_REGISTER_ACTION_DECLARATION(...)= " \
 "HPX_REGISTER_ACTION(...)= " \
 "HPX_REGISTER_COMPONENT(...)= " \
 "HPX_DEFINE_COMPONENT_ACTION(...)= " \
 "HPX_ACTION_USES_MESSAGE_COALESCING_NOTHROW_DECLARATION(...)= " \
 "HPX_ACTION_USES_MESSAGE_COALESCING_NOTHROW_DEFINITION(...)= "
