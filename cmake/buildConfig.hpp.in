/** @file
 * @brief Immutable dimensional and module configuration generated by CMake.
 * @ingroup runtime
 */
#pragma once
#define OCTOTIGERII_NDIM @OCTOTIGERII_NDIM@
#define OCTOTIGERII_GRAVITY @OCTOTIGERII_GRAVITY@
#define OCTOTIGERII_HYDRO @OCTOTIGERII_HYDRO@
#define OCTOTIGERII_RADIATION @OCTOTIGERII_RADIATION@

namespace octotigerII {
inline constexpr int ndim = OCTOTIGERII_NDIM;
static_assert(ndim >= 1 && ndim <= 3);
namespace build {
inline constexpr char executable[] = "@OCTOTIGERII_EXECUTABLE@";
inline constexpr bool hydro = OCTOTIGERII_HYDRO;
inline constexpr bool radiation = OCTOTIGERII_RADIATION;
inline constexpr bool gravity = OCTOTIGERII_GRAVITY;
static_assert(!gravity || ndim == 3);
}
}
